// Prisma 7 — схема базы данных «FindJob» (сервис поиска работы и вакансий).
// Создание самой БД выполняется нативным SQL-скриптом db/create.sql,
// все таблицы создаются/изменяются только через миграции Prisma.

generator client {
  provider        = "prisma-client-js"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Роли пользователей системы
enum Role {
  applicant // соискатель
  company   // работодатель
  admin     // администратор
}

// Статусы отклика на вакансию
enum ResponseStatus {
  new
  viewed
  interview
  rejected
  withdrawn
  hired
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  passhash  String   @db.VarChar(255)
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  company   Company?
  applicant Applicant?

  @@map("users")
}

model Company {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  name        String   @unique
  description String?
  website     String?
  address     String
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies Vacancy[]
  reviews   Review[]

  @@map("companies")
}

model Applicant {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  firstName String   @map("first_name") @db.VarChar(128)
  lastName  String   @map("last_name") @db.VarChar(128)
  phone     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes   Resume[]
  responses Response[]
  reviews   Review[]

  @@map("applicants")
}

model Resume {
  id          Int      @id @default(autoincrement())
  applicantId Int      @map("applicant_id")
  isPrimary   Boolean  @default(false) @map("is_primary")
  title       String
  skills      String
  experience  String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  applicant Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  responses Response[]

  @@map("resumes")
}

model Vacancy {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  title       String   @db.VarChar(64)
  description String
  salaryFrom  Decimal  @map("salary_from") @db.Decimal(12, 2)
  salaryTo    Decimal  @map("salary_to") @db.Decimal(12, 2)
  location    String
  isRemote    Boolean  @default(false) @map("is_remote")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responses Response[]

  @@map("vacancies")
}

model Response {
  id          Int            @id @default(autoincrement())
  vacancyId   Int            @map("vacancy_id")
  applicantId Int            @map("applicant_id")
  resumeId    Int            @map("resume_id")
  status      ResponseStatus @default(new)
  coverLetter String?        @map("cover_letter")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  vacancy   Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume    Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, applicantId])
  @@map("responses")
}

model Review {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  seekerId  Int      @map("seeker_id")
  rating    Int      @db.SmallInt
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seeker  Applicant @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([companyId, seekerId])
  @@map("reviews")
}
